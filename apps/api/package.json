{
  "name": "@eq/api",
  "version": "0.1.0",
  "private": true,
  "description": "Endpoint Quality backend: NestJS + CQRS over TypeORM, the same code in local (SQLite) and cloud (PostgreSQL) mode.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "node --import tsx --test --test-timeout=120000 test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@eq/runner-core": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.2.7",
    "@prometheus-io/client": "0.16.1",
    "bullmq": "5.76.0",
    "nodemailer": "10.0.13",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sql.js": "1.13.0",
    "typeorm": "0.3.31",
    "undici": "7.16.0",
    "yaml": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/sql.js": "1.4.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./spec": "./src/modules/specs/domain/spec.ts"
  }
}
