# Copy to docker/.env and fill in. Never commit docker/.env.
#
#   cp docker/.env.example docker/.env
#   docker compose -f docker/compose.yml --env-file docker/.env up -d

# --- Required -------------------------------------------------------------------------------
# Encrypts the environments' credentials. Keep a copy somewhere other than the server and the
# backups: without it the stored credentials cannot be decrypted.   openssl rand -base64 32
EQ_SECRETS_KEY=
# Signs the sessions, at least 32 characters.                          openssl rand -base64 48
EQ_JWT_SECRET=
# The PostgreSQL password of the bundled database.
POSTGRES_PASSWORD=eq

# --- Access ---------------------------------------------------------------------------------
# invite: the first account registers, everyone else by invitation. open: anyone registers.
# It also decides who single sign-on lets in (open: anyone from the allowed domains).
EQ_REGISTRATION=invite
# Proxy hops to trust (1 behind one HTTPS proxy): the real client address for rate limits and the
# audit log.
EQ_TRUST_PROXY=
# true lets runs reach private addresses: only for a deployment inside the same private network.
EQ_ALLOW_PRIVATE_TARGETS=false
# Allowed origins, comma-separated, only if the web app is served from another domain.
EQ_CORS_ORIGINS=
EQ_RUN_CONCURRENCY=2

# --- Public address -------------------------------------------------------------------------
# The address people open. Emailed links and the SSO redirect are built from it (never from a
# request's Host header). Required with EQ_SMTP_URL or EQ_OIDC_ISSUER.
EQ_PUBLIC_URL=http://localhost:4400

# --- Email (password reset links and run notifications) --------------------------------------
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465; URL-encode @ as %40.
# Empty: nothing is sent, "Forgot password" only logs that a reset was asked for, and email is
# not offered for notifications. Instead of the URL, EQ_SMTP_HOST, EQ_SMTP_PORT, EQ_SMTP_SECURE,
# EQ_SMTP_USER and EQ_SMTP_PASSWORD also work (the URL wins when both are set).
EQ_SMTP_URL=
EQ_MAIL_FROM=Endpoint Quality <no-reply@example.com>

# --- Metrics (Prometheus) --------------------------------------------------------------------
# true serves GET /metrics. With a token, the scraper sends "Authorization: Bearer <token>".
EQ_METRICS=false
EQ_METRICS_TOKEN=

# --- Single sign-on (OpenID Connect) ---------------------------------------------------------
# Empty issuer: off. Register $EQ_PUBLIC_URL/v1/auth/oidc/callback as the redirect URI.
EQ_OIDC_ISSUER=
EQ_OIDC_CLIENT_ID=
EQ_OIDC_CLIENT_SECRET=
# Email domains allowed to sign in with SSO, comma-separated. Empty: any verified email.
EQ_OIDC_ALLOWED_DOMAINS=
# The provider's name on the sign-in button ("Sign in with Google").
EQ_OIDC_NAME=SSO
