{
  "openapi": "3.1.0",
  "info": { "title": "Store 3.1", "version": "2.0.0" },
  "servers": [{ "url": "http://127.0.0.1:4010" }],
  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "tags": ["orders"],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": ["integer", "null"], "minimum": 1, "maximum": 50, "examples": [10] } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["open", "closed"] } }
        ],
        "responses": { "200": { "description": "Orders", "content": { "application/json": { "schema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } } } }, "422": { "description": "Invalid" } }
      },
      "post": {
        "operationId": "createOrder",
        "tags": ["orders"],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewOrder" } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order", "description": "The order as stored" } } } } }
      }
    },
    "/v1/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "tags": ["orders"],
        "parameters": [{ "name": "order_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "One order", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } }, "404": { "description": "Missing" } }
      }
    }
  },
  "components": {
    "schemas": {
      "NewOrder": {
        "type": "object",
        "required": ["kind", "total"],
        "properties": {
          "kind": { "const": "order" },
          "total": { "type": "number", "exclusiveMinimum": 0, "examples": [12.5] },
          "note": { "type": ["string", "null"] }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "kind", "total", "lines"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "const": "order" },
          "total": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": ["string", "null"] },
          "lines": { "type": "array", "prefixItems": [{ "$ref": "#/components/schemas/Line" }], "items": { "$ref": "#/components/schemas/Line" }, "minItems": 1 },
          "meta": { "type": "object", "patternProperties": { "^x-": { "type": "string" } }, "additionalProperties": false }
        }
      },
      "Line": { "$defs": { "sku": { "type": "string", "pattern": "^[A-Z]{3}-\\d+$" } }, "type": "object", "required": ["sku"], "properties": { "sku": { "$ref": "#/components/schemas/Line/$defs/sku" }, "qty": { "type": "integer", "minimum": 1 } } }
    }
  }
}
