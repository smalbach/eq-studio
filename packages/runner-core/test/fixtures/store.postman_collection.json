{
  "info": { "_postman_id": "8c1b3f8e-0000-4000-8000-000000000001", "name": "Store collection", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:4010" }, { "key": "orderId", "value": "42" }],
  "item": [
    { "name": "Health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }, "response": [{ "name": "Up", "code": 200, "status": "OK", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": "{\"status\":\"ok\"}" }] },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List orders",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-Request-Id", "value": "abc" }], "url": { "raw": "{{baseUrl}}/v1/orders?limit=10&status=open&debug=1", "host": ["{{baseUrl}}"], "path": ["v1", "orders"], "query": [{ "key": "limit", "value": "10" }, { "key": "status", "value": "open" }, { "key": "debug", "value": "1", "disabled": true }] } },
          "response": [{ "name": "Some orders", "code": 200, "body": "{\"data\":[{\"id\":\"42\",\"total\":12.5,\"created_at\":\"2030-01-01T00:00:00Z\",\"note\":null}]}" }]
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["v1", "orders", "{{orderId}}"] } },
          "response": [{ "name": "Found", "code": 200, "body": "{\"id\":\"42\",\"total\":12.5}" }, { "name": "Missing", "code": 404, "body": "{\"title\":\"Not Found\",\"status\":404}" }]
        },
        {
          "name": "Create order",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reference\": \"A-1\",\n  \"total\": {{total}},\n  \"owner\": \"{{owner}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/v1/orders" }
        },
        {
          "name": "Order items",
          "item": [
            { "name": "Delete item", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/v1/orders/:order_id/items/:item_id", "host": ["{{baseUrl}}"], "path": ["v1", "orders", ":order_id", "items", ":item_id"], "variable": [{ "key": "order_id", "value": "42" }, { "key": "item_id", "value": "7" }] } } }
          ]
        }
      ]
    }
  ]
}
